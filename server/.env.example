# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000

# Used to turn relative TenantSettings.logoUrl (e.g. /logo.png) into absolute URLs in emails.
# Should match your live Next.js origin (same as FRONTEND_URL if the logo is served from the app).
# FRONTEND_URL=https://your-portal.example.com
# EMAIL_ASSET_BASE_URL=https://your-portal.example.com

# School / thesis build: lock org settings & developer APIs. Pair with NEXT_PUBLIC_SCHOOL_BUILD on the Next app.
# SCHOOL_BUILD=true

# Student registration roster (name + Student ID + optional department). Empty JSON array [] disables checks.
# Default file: config/data/studentRoster.json (relative to server working directory).
# STUDENT_ROSTER_PATH=C:\path\to\custom-roster.json

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Access token lifetime (e.g. 8h, 24h, 7d). Default 8h — align with your session policy.
JWT_EXPIRES_IN=8h

# Supabase Database URLs
# Get these from: Supabase Dashboard → Settings → Database
# Replace [PASSWORD] with your database password
# Transaction pooler (port 6543) for the running app. Include pgbouncer=true for Prisma.
# If you see P2024 (pool timeout) or P1001 (can't reach DB): confirm project is not paused, then try appending:
#   &connection_limit=5&pool_timeout=30&connect_timeout=15
# Use a single API process locally so the pool is not exhausted across multiple servers.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Email — pick ONE provider (best for defense demo: Brevo — sends to any address after you verify ONE sender)
# Set EMAIL_PROVIDER so Resend is not used accidentally if both keys exist.
#
# EMAIL_PROVIDER=brevo
# MAIL_FROM="Grievance Portal <your-verified-sender@gmail.com>"
#
# --- Option A: Brevo (recommended for thesis demo) ---
# 1) Sign up at https://www.brevo.com (free tier)
# 2) Senders → verify ONE email (e.g. your Gmail) — no whole domain required
# 3) SMTP & API → create SMTP key
# EMAIL_PROVIDER=brevo
# BREVO_SMTP_USER=your-brevo-login@email.com
# BREVO_SMTP_KEY=xsmtpsib-xxxxxxxx
# MAIL_FROM="Grievance Portal <same-verified-sender@gmail.com>"
#
# --- Option B: SendGrid ---
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxx
# MAIL_FROM="Grievance Portal <verified-sender@email.com>"
#
# --- Option C: Gmail / custom SMTP ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Grievance Portal <your-email@gmail.com>"
#
# --- Option D: Resend (production; needs verified domain to reach everyone) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM_NAME=Grievance Portal
#
# If email is configured, users must verify before login unless you set:
# REQUIRE_EMAIL_VERIFICATION=false

# Supabase Storage (required for petition file attachments)
# Dashboard → Settings → API → Project URL + service_role key (keep secret)
# Create a public Storage bucket named exactly: petition-attachments
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

