// This is your Prisma schema file for Supabase PostgreSQL
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Connection pooling URL (for queries)
  directUrl = env("DIRECT_URL") // Direct connection URL (for migrations)
}

model Organization {
  id               String @id @default(cuid())
  name             String
  slug             String @unique
  status           String @default("active")
  subscriptionTier String @default("starter")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  settings          TenantSettings?
  users             User[]
  tickets           Ticket[]
  comments          TicketComment[]
  attachments       TicketAttachment[]
  statusHistory     TicketStatusHistory[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  registryStudents  RegistryStudent[]
  advisorAssignments AdvisorLevelAssignment[]
  apiTokens         ApiToken[]
  webhooks          WebhookEndpoint[]
}

model WorkspaceRequest {
  id                String   @id @default(uuid())
  organizationName  String
  preferredSlug     String
  contactName       String
  contactEmail      String
  message           String?
  status            String   @default("new")
  source             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contactEmail])
}

model DemoRequest {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String
  message      String
  status       String   @default("new")
  source       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// Tenant/Organization settings — CMS-driven configuration
model TenantSettings {
  id               String  @id @default(uuid())
  organizationId   String  @unique @default("default")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationName String  @default("Resolve")
  logoUrl          String?
  primaryColor     String  @default("#2563eb")
  accentColor      String  @default("#0f172a")
  supportEmail     String?
  marketingContent Json    @default("{}")

  // Dynamic roles config: [{key: "submitter", label: "Submitter", level: 0, isSubmitter: true}, ...]
  rolesConfig         Json @default("[]")
  // Escalation chain: [{fromStatus: "submitted", toStatus: "under_review", requiredRoleKey: "class_advisor"}, ...]
  escalationConfig    Json @default("[]")
  // Ticket types: [{key: "academic_issue", label: "Academic Issue"}, ...]
  ticketTypesConfig   Json @default("[]")
  // Status labels: [{key: "submitted", label: "Submitted", color: "#f59e0b"}, ...]
  statusLabelsConfig  Json @default("[]")
  // Allowed email domains (empty = allow all): ["@st.rmu.edu.gh", "@rmu.edu.gh"]
  allowedEmailDomains Json @default("[]")
  // Group-to-index prefixes: {"ICT": ["BIT","BCS"], "Transport": ["BPS"]}
  groupPrefixes       Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User accounts (submitters + admins)
model User {
  id                       String    @id @default(uuid())
  organizationId           String    @default("default")
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                    String
  passwordHash             String
  name                     String
  role                     String // Dynamic role key from TenantSettings.rolesConfig
  submitterId              String?
  isPlatformOwner          Boolean   @default(false)
  group                    String?
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tickets         Ticket[]              @relation("SubmitterTickets")
  assignedTickets Ticket[]              @relation("AssignedTickets")
  comments        TicketComment[]
  statusHistory   TicketStatusHistory[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  levelAssignments AdvisorLevelAssignment[]

  @@index([role, group])
  @@unique([organizationId, email])
  @@unique([organizationId, submitterId])
  @@index([organizationId, role, group])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

// Main ticket table
model Ticket {
  id              String   @id @default(uuid())
  organizationId  String   @default("default")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referenceCode   String? // e.g. PET-2024-001
  submitterId     String
  submitter       User     @relation("SubmitterTickets", fields: [submitterId], references: [id])
  submitterName   String
  submitterEmail  String
  group           String
  year            String
  type            String // Dynamic ticket type key from TenantSettings
  priority        String   @default("medium") // low, medium, high, urgent
  subject         String
  description     String
  status          String   @default("submitted") // Dynamic status key from TenantSettings
  assignedTo      String?
  assignedUser    User?    @relation("AssignedTickets", fields: [assignedTo], references: [id])
  escalationLevel Int      @default(1)
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Lifecycle and SLA fields
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  lastStatusChangedAt DateTime @default(now())

  // Customisation and classification
  tags     String[] @default([])
  metadata Json?

  comments      TicketComment[]
  attachments   TicketAttachment[]
  statusHistory TicketStatusHistory[]
  notifications Notification[]

  @@index([submitterId])
  @@unique([organizationId, referenceCode])
  @@index([organizationId, status, group])
  @@index([assignedTo])
  @@index([status])
  @@index([group, escalationLevel])
  @@index([submittedAt])
  @@index([status, group])
}

// Ticket comments
model TicketComment {
  id         String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  authorName String
  authorRole String // Dynamic role key
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Ticket attachments
model TicketAttachment {
  id         String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedAt DateTime @default(now())
}

// Ticket status history
model TicketStatusHistory {
  id             String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id])
  previousStatus String?
  newStatus      String
  changedBy      String
  changedUser    User     @relation(fields: [changedBy], references: [id])
  changedByName  String
  changedByRole  String // Dynamic role key
  comment        String?
  changedAt      DateTime @default(now())
}

// Notifications
model Notification {
  id        String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([organizationId, userId, isRead])
  @@index([ticketId])
  @@index([createdAt])
}

// Audit logs
model AuditLog {
  id           String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  userName     String?
  userRole     String? // Dynamic role key
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}

// Official student / alumni registry (replaces JSON roster files)
model RegistryStudent {
  id         String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberType String   // student | alumni
  studentId  String
  fullName   String
  department String
  email      String?
  level      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([department])
  @@unique([organizationId, studentId])
  @@index([organizationId, department])
  @@index([memberType])
  @@index([fullName])
}

// Assign advisors to academic levels (and optional petition types) per department
model AdvisorLevelAssignment {
  id            String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  advisorId     String
  advisor       User     @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  department    String
  levels        String[] @default([])
  petitionTypes String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organizationId, advisorId, department])
  @@index([organizationId, department])
  @@index([department])
}

// Developer API Tokens
model ApiToken {
  id        String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name      String   @default("Production Key")
  tokenHash String   @unique // Store hashed, show raw token only once on creation
  createdAt DateTime @default(now())
  lastUsed  DateTime?
  
  @@index([organizationId])
}

// Webhook Endpoints
model WebhookEndpoint {
  id        String   @id @default(uuid())
  organizationId String @default("default")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url       String
  secret    String   // For signing webhook payloads (HMAC)
  events    String[] // e.g., ["ticket.created", "ticket.status_changed"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  
  @@index([organizationId, isActive])
}
